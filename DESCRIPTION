Package: boral
Title: Bayesian Ordination and Regression AnaLysis
Version: 2.0.3
Date: 2025-05-1
Authors@R: c(person(given = c("Francis", "K.C."),
                        family = "Hui",
                        role = c("aut", "cre"),
                        email = "fhui28@gmail.com",
                        comment = c(ORCID = "0000-0003-0765-3533")),
                 person(given = "Wade",
